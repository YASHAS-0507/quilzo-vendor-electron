{
  "name": "quilzo-vendor-dashboard",
  "version": "1.0.0",
  "description": "Electron wrapper for Quilzo vendor dashboard - keeps order notification sounds working when window is unfocused",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "pdf-to-printer": "^5.8.1"
  },
  "build": {
    "appId": "com.quilzo.vendordashboard",
    "productName": "Quilzo Vendor",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "asarUnpack": [
      "node_modules/pdf-to-printer/**"
    ]
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3"
  }
}